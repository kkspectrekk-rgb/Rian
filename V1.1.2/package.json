{
  "name": "rain-music",
  "version": "1.1.2",
  "private": true,
  "description": "Rain — a Windows music player inspired by Apple Music.",
  "author": "Rain",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.aurora.music",
    "productName": "Rain",
    "compression": "store",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "package.json"],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Rain.1.1.2-setup.exe",
      "shortcutName": "Rain",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
